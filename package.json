{
  "name": "kyc-orchestrator",
  "version": "1.0.0",
  "description": "KYC/AML verification orchestration microservice: fans out to identity, sanctions and address vendors, scores risk, manages review cases and delivers signed webhooks.",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').copyFileSync('src/db/schema.sql','dist/db/schema.sql')\"",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "typecheck": "tsc --noEmit",
    "migrate": "node dist/db/migrate.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "express": "5.1.0",
    "pg": "8.16.3",
    "pino": "9.9.5",
    "prom-client": "15.1.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/jest": "29.5.14",
    "@types/node": "22.20.5",
    "@types/pg": "8.15.5",
    "@types/supertest": "6.0.3",
    "jest": "29.7.0",
    "pg-mem": "3.0.5",
    "supertest": "7.1.4",
    "ts-jest": "29.4.15",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
